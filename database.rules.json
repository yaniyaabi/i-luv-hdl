{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        "members": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $code.matches(/^[0-9]{4,8}$/) && (!newData.exists() || data.exists() || root.child('rooms').child($code).child('members').exists() || (!newData.parent().parent().child('messages').exists() && !newData.parent().parent().child('inboxes').exists()))",
            ".validate": "newData.hasChildren(['name','drink','joinedAt']) && ((!newData.child('focusRound').exists() && !newData.child('finishedRound').exists()) || (newData.hasChildren(['focusRound','finishedRound']) && newData.child('focusRound').val() === newData.child('finishedRound').val()+1))",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "drink": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now && (newData.val() === data.val() || newData.val() >= now-60000)"
            },
            "$other": {
              ".validate": false
            },
            "task": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "focusRound": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000000 && (!data.exists() || newData.val() === data.val() || newData.val() === data.val()+1)"
            },
            "finishedRound": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000000 && (!data.exists() || newData.val() === data.val() || newData.val() === data.val()+1)"
            }
          }
        },
        "messages": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          ".indexOn": [
            "created"
          ],
          "$id": {
            ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && ((!newData.exists() && data.child('sender').val() === auth.uid) || (!data.exists() && newData.child('sender').val() === auth.uid))",
            ".validate": "newData.hasChildren(['kind','sender','senderName','recipient','recipientName','body','created'])",
            "kind": {
              ".validate": "newData.val() === 'chat'"
            },
            "sender": {
              ".validate": "newData.val() === auth.uid"
            },
            "senderName": {
              ".validate": "newData.val() === root.child('rooms').child($code).child('members').child(auth.uid).child('name').val()"
            },
            "recipient": {
              ".validate": "newData.val() === ''"
            },
            "recipientName": {
              ".validate": "newData.val() === ''"
            },
            "body": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "created": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          },
          ".write": "auth != null && $code.matches(/^[0-9]{4,8}$/) && !newData.exists() && (!root.child('rooms').child($code).child('members').exists() || !newData.parent().child('members').exists())"
        },
        "inboxes": {
          "$uid": {
            ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && auth.uid === $uid",
            ".indexOn": [
              "created"
            ],
            "$id": {
              ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && ((!newData.exists() && data.child('sender').val() === auth.uid) || (!data.exists() && newData.child('sender').val() === auth.uid && ($uid === auth.uid || $uid === newData.child('recipient').val()) && root.child('rooms').child($code).child('members').child(newData.child('recipient').val()).exists()))",
              ".validate": "newData.hasChildren(['kind','sender','senderName','recipient','recipientName','body','created'])",
              "kind": {
                ".validate": "newData.val() === 'chat'"
              },
              "sender": {
                ".validate": "newData.val() === auth.uid"
              },
              "senderName": {
                ".validate": "newData.val() === root.child('rooms').child($code).child('members').child(auth.uid).child('name').val()"
              },
              "recipient": {
                ".validate": "newData.isString() && newData.val() !== auth.uid && root.child('rooms').child($code).child('members').child(newData.val()).exists()"
              },
              "recipientName": {
                ".validate": "newData.val() === root.child('rooms').child($code).child('members').child(newData.parent().child('recipient').val()).child('name').val()"
              },
              "body": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
              },
              "created": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          ".write": "auth != null && $code.matches(/^[0-9]{4,8}$/) && !newData.exists() && (!root.child('rooms').child($code).child('members').exists() || !newData.parent().child('members').exists())"
        },
        "$other": {
          ".validate": false
        },
        "gifts": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          ".write": "auth != null && $code.matches(/^[0-9]{4,8}$/) && !newData.exists() && (!root.child('rooms').child($code).child('members').exists() || !newData.parent().child('members').exists())",
          ".indexOn": [
            "created"
          ],
          "$id": {
            ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && $id.matches(/^[A-Za-z0-9_-]{20,64}$/) && !data.exists() && newData.child('sender').val() === auth.uid",
            ".validate": "newData.hasChildren(['kind','sender','senderName','recipient','recipientName','created'])",
            "sender": {
              ".validate": "newData.val() === auth.uid"
            },
            "senderName": {
              ".validate": "newData.val() === root.child('rooms').child($code).child('members').child(auth.uid).child('name').val()"
            },
            "recipient": {
              ".validate": "newData.isString() && newData.val() !== auth.uid && root.child('rooms').child($code).child('members').child(newData.val()).exists()"
            },
            "recipientName": {
              ".validate": "newData.val() === root.child('rooms').child($code).child('members').child(newData.parent().child('recipient').val()).child('name').val()"
            },
            "created": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            },
            "kind": {
              ".validate": "newData.val() === 'cookie'"
            }
          }
        },
        "letterBoxes": {
          ".write": "auth != null && $code.matches(/^[0-9]{4,8}$/) && !newData.exists() && (!root.child('rooms').child($code).child('members').exists() || !newData.parent().child('members').exists())",
          "$uid": {
            ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && auth.uid === $uid",
            ".indexOn": [
              "created"
            ],
            "$id": {
              ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && (!data.exists() || data.child('sender').val() === auth.uid)",
              ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && $id.matches(/^[A-Za-z0-9_-]{20,64}$/) && !data.exists() && newData.child('sender').val() === auth.uid",
              ".validate": "newData.hasChildren(['sender','senderName','recipient','recipientName','round','created']) && newData.child('recipient').val() === $uid && newData.parent().parent().parent().child('letterBodies').child($uid).child($id).child('sender').val() === auth.uid && newData.parent().parent().parent().child('letterBodies').child($uid).child($id).child('body').isString()",
              "sender": {
                ".validate": "newData.val() === auth.uid"
              },
              "senderName": {
                ".validate": "newData.val() === root.child('rooms').child($code).child('members').child(auth.uid).child('name').val()"
              },
              "recipient": {
                ".validate": "newData.isString() && newData.val() !== auth.uid && root.child('rooms').child($code).child('members').child(newData.val()).exists()"
              },
              "recipientName": {
                ".validate": "newData.val() === root.child('rooms').child($code).child('members').child(newData.parent().child('recipient').val()).child('name').val()"
              },
              "created": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              },
              "round": {
                ".validate": "newData.isNumber() && newData.val() === root.child('rooms').child($code).child('members').child($uid).child('focusRound').val()"
              }
            }
          }
        },
        "letterBodies": {
          ".write": "auth != null && $code.matches(/^[0-9]{4,8}$/) && !newData.exists() && (!root.child('rooms').child($code).child('members').exists() || !newData.parent().child('members').exists())",
          "$uid": {
            "$id": {
              ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && (data.child('sender').val() === auth.uid || (auth.uid === $uid && root.child('rooms').child($code).child('letterBoxes').child($uid).child($id).exists() && root.child('rooms').child($code).child('members').child(auth.uid).child('finishedRound').val() >= root.child('rooms').child($code).child('letterBoxes').child($uid).child($id).child('round').val()))",
              ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && $id.matches(/^[A-Za-z0-9_-]{20,64}$/) && !data.exists() && newData.child('sender').val() === auth.uid",
              ".validate": "newData.hasChildren(['sender','body']) && newData.parent().parent().parent().child('letterBoxes').child($uid).child($id).child('sender').val() === auth.uid && newData.parent().parent().parent().child('letterBoxes').child($uid).child($id).child('recipient').val() === $uid",
              "sender": {
                ".validate": "newData.val() === auth.uid"
              },
              "body": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "memeComments": {
      "$memeId": {
        ".read": "auth != null && $memeId.matches(/^(boss-energy|study-fire|princess|commute|success-2026)$/) && query.orderByChild === 'created' && query.limitToLast > 0 && query.limitToLast <= 100",
        ".indexOn": [
          "created"
        ],
        "$id": {
          ".write": "auth != null && $memeId.matches(/^(boss-energy|study-fire|princess|commute|success-2026)$/) && $id.matches(/^[A-Za-z0-9_-]{20,64}$/) && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (!newData.exists() && data.child('authorId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['authorId','authorName','body','created'])",
          "authorId": {
            ".validate": "newData.val() === auth.uid"
          },
          "authorName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          },
          "created": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "stackBoards": {
      "$month": {
        "items": {
          ".read": "auth != null && $month.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])$/) && query.orderByChild === 'created' && query.limitToLast > 0 && query.limitToLast <= 100",
          ".indexOn": [
            "created"
          ],
          "$id": {
            ".write": "auth != null && $month.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])$/) && $id.matches(/^[A-Za-z0-9_-]{8,64}$/) && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || data.child('ownerId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['kind','ownerId','ownerName','content','x','y','w','h','rotation','z','color','fontSize','created','updated','deleted'])",
            "kind": {
              ".validate": "(newData.val() === 'image' || newData.val() === 'text') && (!data.exists() || newData.val() === data.val())"
            },
            "ownerId": {
              ".validate": "newData.val() === auth.uid"
            },
            "ownerName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "content": {
              ".validate": "newData.isString() && ((newData.parent().child('kind').val() === 'image' && (newData.val() === $id || newData.val().matches(/^meme:(boss-energy|study-fire|princess|commute|success-2026)$/))) || (newData.parent().child('kind').val() === 'text' && newData.val().length > 0 && newData.val().length <= 180))"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1152 && newData.val()+newData.parent().child('w').val() <= 1152"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1660 && newData.val()+newData.parent().child('h').val() <= 1660"
            },
            "w": {
              ".validate": "newData.isNumber() && newData.val() >= 80 && newData.val() <= 800"
            },
            "h": {
              ".validate": "newData.isNumber() && newData.val() >= 40 && newData.val() <= 1000"
            },
            "rotation": {
              ".validate": "newData.isNumber() && newData.val() >= -45 && newData.val() <= 45"
            },
            "z": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[A-Fa-f0-9]{6}$/)"
            },
            "fontSize": {
              ".validate": "newData.isNumber() && newData.val() >= 32 && newData.val() <= 180"
            },
            "created": {
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
            },
            "updated": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "deleted": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stackImages": {
      "$month": {
        "$id": {
          ".read": "auth != null && $month.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])$/) && $id.matches(/^[A-Za-z0-9_-]{8,64}$/)",
          ".write": "auth != null && $month.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])$/) && $id.matches(/^[A-Za-z0-9_-]{8,64}$/) && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || (!newData.exists() && data.child('ownerId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['ownerId','image','created'])",
          "ownerId": {
            ".validate": "newData.val() === auth.uid"
          },
          "image": {
            ".validate": "newData.isString() && newData.val().length <= 180000 && (newData.val().beginsWith('data:image/webp;base64,') || newData.val().beginsWith('data:image/png;base64,') || newData.val().beginsWith('data:image/jpeg;base64,'))"
          },
          "created": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "stackComments": {
      "$month": {
        "$itemId": {
          ".read": "auth != null && $month.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])$/) && root.child('stackBoards').child($month).child('items').child($itemId).exists() && root.child('stackBoards').child($month).child('items').child($itemId).child('deleted').val() === false && query.orderByChild === 'created' && query.limitToLast > 0 && query.limitToLast <= 100",
          ".indexOn": [
            "created"
          ],
          "$id": {
            ".write": "auth != null && $month.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])$/) && $id.matches(/^[A-Za-z0-9_-]{20,64}$/) && ((!data.exists() && root.child('stackBoards').child($month).child('items').child($itemId).exists() && root.child('stackBoards').child($month).child('items').child($itemId).child('deleted').val() === false && newData.child('authorId').val() === auth.uid) || (!newData.exists() && data.child('authorId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['authorId','authorName','body','created'])",
            "authorId": {
              ".validate": "newData.val() === auth.uid"
            },
            "authorName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "body": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "created": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
